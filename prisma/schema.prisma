generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  CREATOR
  ADMIN
}

enum WhitelistStatus {
  NONE
  INVITED
  ACTIVE
}

enum AgentPackageStatus {
  DRAFT
  VALIDATING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ConsultationStatus {
  NEW
  IN_DISCUSSION
  SCOPED
  ORDER_CREATED
  CLOSED
}

enum ServiceOrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum StorageProviderKind {
  LOCAL
  S3_COMPATIBLE
}

enum PackageType {
  SINGLE
  TEAM
}

enum PricingType {
  FREE
  PAID
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum DisputeResolutionType {
  REFUND_FULL
  REFUND_PARTIAL
  REJECTED
  RETURN_TO_PROGRESS
  RETURN_TO_DELIVERED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SettlementLineStatus {
  PENDING
  LOCKED
  SETTLED
}

enum SettlementBatchStatus {
  DRAFT
  SUBMITTED
  PAID_OUT
  FAILED
}

enum SettlementAdjustmentStatus {
  PENDING
  APPLIED
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String?
  role            UserRole        @default(USER)
  whitelistStatus WhitelistStatus @default(NONE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  packages        AgentPackage[]
  favorites       AgentPackageFavorite[]
  reviews         AgentPackageReview[]
  importInstructions AgentPackageImportInstruction[]
  sessions        Session[]
  magicLinkTokens MagicLinkToken[]
  buyerConsultations Consultation[] @relation("BuyerConsultations")
  providerConsultations Consultation[] @relation("ProviderConsultations")
  buyerOrders      ServiceOrder[]  @relation("BuyerOrders")
  providerOrders   ServiceOrder[]  @relation("ProviderOrders")
  providerDeliveries Delivery[]    @relation("ProviderDeliveries")
  openedDisputes   Dispute[]       @relation("OpenedDisputes")
  disputeEvidence  DisputeEvidence[] @relation("DisputeEvidenceSubmitters")
  requestedRefunds Refund[]        @relation("RequestedRefunds")
  settlementLines  SettlementLine[] @relation("ProviderSettlementLines")
  settlementBatches SettlementBatch[] @relation("ProviderSettlementBatches")
  settlementAdjustments SettlementAdjustment[]
  oAuthAccounts    OAuthAccount[]
}

model OAuthAccount {
  id               String   @id @default(cuid())
  provider         String
  providerAccountId String
  userId           String
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model MagicLinkToken {
  id         String   @id @default(cuid())
  email      String
  tokenHash  String   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentPackage {
  id               String             @id @default(cuid())
  ownerId          String
  name             String
  slug             String             @unique
  version          String
  summary          String
  categories       String[]
  metadataJson     Json
  zipFileUrl       String
  zipFileName      String
  zipSizeBytes     Int
  objectKey        String?
  storageProvider  StorageProviderKind? @default(LOCAL)
  bucket           String?
  mimeType         String?
  contentDisposition String?
  checksum         String?
  deletedAt        DateTime?
  coverUrl         String?
  downloadCount    Int                @default(0)
  status           AgentPackageStatus @default(DRAFT)
  validationResult Json
  publishedAt      DateTime?
  packageType       PackageType  @default(SINGLE) @map("package_type")
  pricingType       PricingType  @default(FREE) @map("pricing_type")
  priceCents        Int          @default(0) @map("price_cents")
  platformFeeRate   Int          @default(20) @map("platform_fee_rate")
  soulPreview       String?      @map("soul_preview")
  behaviorDigest    String?      @map("behavior_digest")
  routingDefault    String?      @map("routing_default")
  routingFallback   String?      @map("routing_fallback")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  owner            User               @relation(fields: [ownerId], references: [id])
  skills           Skill[]
  workflows        Workflow[]
  consultations    Consultation[]
  favorites        AgentPackageFavorite[]
  reviews          AgentPackageReview[]
  importInstructions AgentPackageImportInstruction[]
  childAgents       TeamAgent[]  @relation("TeamToAgents")
  parentTeam        TeamAgent[]  @relation("AgentInTeam")

  @@index([ownerId, createdAt])
  @@index([status, publishedAt])
}

model AgentPackageFavorite {
  id             String       @id @default(cuid())
  agentPackageId String
  userId         String
  createdAt      DateTime     @default(now())

  agentPackage   AgentPackage @relation(fields: [agentPackageId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentPackageId, userId])
  @@index([userId, createdAt])
}

model AgentPackageReview {
  id             String       @id @default(cuid())
  agentPackageId String
  userId         String
  rating         Int
  title          String?
  body           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  agentPackage   AgentPackage @relation(fields: [agentPackageId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentPackageId, userId])
  @@index([agentPackageId, createdAt])
  @@index([userId, createdAt])
}

model AgentPackageImportInstruction {
  id             String       @id @default(cuid())
  agentPackageId String       @unique
  createdByUserId String?
  cliCommand     String
  oneClickUrl    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  agentPackage   AgentPackage @relation(fields: [agentPackageId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([agentPackageId])
  @@index([createdByUserId, createdAt])
}

model DownloadTicketUse {
  id           String   @id @default(cuid())
  jti          String   @unique
  keyId        String
  audience     String
  resourceType String
  resourceId   String
  actorId      String?
  sessionId    String?
  usedAt       DateTime @default(now())
  expiresAt    DateTime

  @@index([resourceType, resourceId, usedAt])
  @@index([actorId, usedAt])
}

model Skill {
  id             String       @id @default(cuid())
  agentPackageId String
  name           String
  path           String
  description    String

  agentPackage   AgentPackage @relation(fields: [agentPackageId], references: [id], onDelete: Cascade)

  @@index([agentPackageId])
}

model Workflow {
  id             String       @id @default(cuid())
  agentPackageId String
  name           String
  path           String
  description    String

  agentPackage   AgentPackage @relation(fields: [agentPackageId], references: [id], onDelete: Cascade)

  @@index([agentPackageId])
}

model Consultation {
  id             String             @id @default(cuid())
  agentPackageId String
  providerId     String
  buyerEmail     String
  buyerUserId    String?
  requirement    String
  status         ConsultationStatus @default(NEW)
  scopedSummary  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  agentPackage   AgentPackage       @relation(fields: [agentPackageId], references: [id], onDelete: Cascade)
  provider       User               @relation("ProviderConsultations", fields: [providerId], references: [id], onDelete: Cascade)
  buyerUser      User?              @relation("BuyerConsultations", fields: [buyerUserId], references: [id], onDelete: SetNull)
  orders         ServiceOrder[]

  @@index([agentPackageId])
  @@index([providerId, createdAt])
  @@index([buyerEmail, createdAt])
  @@index([buyerUserId])
}

model ServiceOrder {
  id               String             @id @default(cuid())
  consultationId   String
  buyerEmail       String
  buyerUserId      String?
  providerId       String
  title            String
  scope            String
  priceCents       Int
  currency         String
  status           ServiceOrderStatus @default(PENDING_PAYMENT)
  paymentStatus    PaymentStatus      @default(UNPAID)
  paymentProvider  String
  paymentReference String?
  workStartedAt    DateTime?
  settledAt        DateTime?
  settlementReference String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  consultation     Consultation       @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  buyerUser        User?              @relation("BuyerOrders", fields: [buyerUserId], references: [id], onDelete: SetNull)
  provider         User               @relation("ProviderOrders", fields: [providerId], references: [id], onDelete: Cascade)
  deliveries       Delivery[]
  paymentLedgerEntries PaymentLedger[]
  disputes         Dispute[]
  refunds          Refund[]
  settlementLine   SettlementLine?
  settlementAdjustments SettlementAdjustment[]

  @@unique([consultationId])
  @@index([providerId, createdAt])
  @@index([buyerEmail, createdAt])
  @@index([buyerUserId])
  @@index([status, paymentStatus])
  @@index([status, settledAt])
}

model PaymentLedger {
  id                        String        @id @default(cuid())
  orderId                   String
  provider                  String
  providerPaymentId         String?
  providerCheckoutSessionId String?
  providerEventId           String        @unique
  amountMinor               Int
  currency                  String
  paymentStatus             PaymentStatus
  failureReason             String?
  idempotencyKey            String?
  lastWebhookEventId        String?
  lastWebhookReceivedAt     DateTime      @default(now())
  rawEventDigest            String
  rawEventStoredAt          DateTime?
  createdAt                 DateTime      @default(now())

  order                     ServiceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([provider, paymentStatus, createdAt])
}

model Delivery {
  id            String       @id @default(cuid())
  serviceOrderId String
  providerId    String
  fileUrl       String
  fileName      String
  fileSizeBytes Int
  objectKey     String?
  storageProvider StorageProviderKind? @default(LOCAL)
  bucket        String?
  mimeType      String?
  contentDisposition String?
  checksum      String?
  deletedAt     DateTime?
  note          String?
  submittedAt   DateTime     @default(now())
  acceptedAt    DateTime?
  createdAt     DateTime     @default(now())

  serviceOrder  ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  provider      User         @relation("ProviderDeliveries", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId, submittedAt])
  @@index([providerId, submittedAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorRole      String
  action         String
  targetType     String
  targetId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}

model Dispute {
  id               String                @id @default(cuid())
  orderId          String
  openedByUserId   String?
  reason           String
  status           DisputeStatus         @default(OPEN)
  resolutionType   DisputeResolutionType?
  resolutionNote   String?
  responseDueAt    DateTime?
  resolvedAt       DateTime?
  visibility       String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  order            ServiceOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedByUser     User?                 @relation("OpenedDisputes", fields: [openedByUserId], references: [id], onDelete: SetNull)
  evidence         DisputeEvidence[]
  refunds          Refund[]

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model DisputeEvidence {
  id                  String    @id @default(cuid())
  disputeId           String
  submittedByUserId   String?
  note                String?
  attachmentObjectKey String?
  attachmentFileName  String?
  visibleToBuyer      Boolean   @default(true)
  visibleToProvider   Boolean   @default(true)
  createdAt           DateTime  @default(now())

  dispute             Dispute   @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  submittedByUser     User?     @relation("DisputeEvidenceSubmitters", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@index([disputeId, createdAt])
}

model Refund {
  id                String       @id @default(cuid())
  orderId           String
  disputeId         String?
  provider          String
  paymentReference  String
  amountMinor       Int
  currency          String
  status            RefundStatus @default(PENDING)
  providerRefundId  String?
  providerEventId   String?      @unique
  failureReason     String?
  requestedByUserId String?
  requestedAt       DateTime     @default(now())
  completedAt       DateTime?
  createdAt         DateTime     @default(now())

  order             ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispute           Dispute?     @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  requestedByUser   User?        @relation("RequestedRefunds", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model SettlementLine {
  id                     String               @id @default(cuid())
  orderId                String               @unique
  providerId             String
  grossAmountMinor       Int
  feeRate                Decimal              @default(0)
  feePolicySnapshot      Json?
  platformFeeAmountMinor Int
  netAmountMinor         Int
  refundDeductionAmount  Int                  @default(0)
  adjustmentAmount       Int                  @default(0)
  currency               String
  status                 SettlementLineStatus @default(PENDING)
  eligibleAt             DateTime
  holdUntil              DateTime?
  lockedAt               DateTime?
  settledAt              DateTime?
  settlementBatchId      String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  order                  ServiceOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider               User                 @relation("ProviderSettlementLines", fields: [providerId], references: [id], onDelete: Cascade)
  settlementBatch        SettlementBatch?     @relation(fields: [settlementBatchId], references: [id], onDelete: SetNull)
  adjustments            SettlementAdjustment[]

  @@index([providerId, status, eligibleAt])
  @@index([settlementBatchId])
}

model SettlementAdjustment {
  id                     String                     @id @default(cuid())
  providerId             String
  orderId                String
  sourceSettlementLineId String?
  settlementBatchId      String?
  amountMinor            Int
  currency               String
  reason                 String
  status                 SettlementAdjustmentStatus @default(PENDING)
  createdAt              DateTime                   @default(now())
  appliedAt              DateTime?

  provider               User                       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  order                  ServiceOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceSettlementLine   SettlementLine?            @relation(fields: [sourceSettlementLineId], references: [id], onDelete: SetNull)
  settlementBatch        SettlementBatch?           @relation(fields: [settlementBatchId], references: [id], onDelete: SetNull)

  @@index([providerId, status, createdAt])
  @@index([orderId, createdAt])
  @@index([settlementBatchId])
}

model SettlementBatch {
  id               String                @id @default(cuid())
  providerId       String
  totalAmountMinor Int
  currency         String
  status           SettlementBatchStatus @default(DRAFT)
  payoutReference  String?
  submittedAt      DateTime?
  paidOutAt        DateTime?
  lineSnapshot     Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  provider         User                  @relation("ProviderSettlementBatches", fields: [providerId], references: [id], onDelete: Cascade)
  settlementLines  SettlementLine[]
  settlementAdjustments SettlementAdjustment[]

  @@index([providerId, status, createdAt])
}

model TeamAgent {
  id          String  @id @default(cuid())
  teamId      String  @map("team_id")
  agentId     String  @map("agent_id")
  role        String
  triggers    String[]
  sortOrder   Int     @default(0) @map("sort_order")

  team        AgentPackage @relation("TeamToAgents", fields: [teamId], references: [id], onDelete: Cascade)
  agent       AgentPackage @relation("AgentInTeam", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([teamId, agentId])
  @@map("team_agents")
}
